<%- include('partials/header') %>
<div class="authbox">
  <img class="authlogo" src="/logo.jpg" alt="<%= settings.org_name %> logo">
  <h1 class="sr-only"><%= settings.org_name %></h1>
  <p class="muted">Sign in to view contributions.</p>
  <form method="post" action="/login" class="stack">
    <label>Username <input name="username" autocomplete="username" required autofocus></label>
    <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn primary">Sign in</button>
  </form>
  <p class="muted small">Forgot your password? Ask the administrator to reset it.</p>
</div>
<%- include('partials/footer') %>
